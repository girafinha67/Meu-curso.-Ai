# ===== SUPABASE =====
# Encontre em: Supabase Dashboard > Project Settings > API
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Usada apenas nas Edge Functions (backend), NUNCA no frontend
SUPABASE_SERVICE_ROLE_KEY=

# ===== IA (avaliação de respostas abertas) =====
# Chave da API do provedor de IA escolhido (ex.: OpenAI, Anthropic).
# Usada apenas dentro da Edge Function "evaluate-answer" — nunca no frontend.
AI_API_KEY=
AI_MODEL=gpt-4o-mini

# ===== PAGAMENTO (Mercado Pago — Pix e cartão) =====
# Encontre no painel do Mercado Pago > Suas integrações
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=

# ===== APP =====
VITE_APP_URL=http://localhost:3000
